{
  "name": "lumen-dmx",
  "version": "0.1.3",
  "description": "Console local de iluminação DMX para igrejas",
  "author": "CPJCL",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never",
    "rebuild-native": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "br.com.cpjcl.lumen",
    "productName": "Lumen DMX",
    "directories": { "output": "release" },
    "npmRebuild": false,
    "files": ["src/**/*", "package.json", "README.md"],
    "publish": [{ "provider": "github", "owner": "psilaslis-ship-it", "repo": "CPJCL" }],
    "win": { "target": ["portable", "nsis"] }
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  }
}
